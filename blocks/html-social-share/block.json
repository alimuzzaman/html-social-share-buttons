{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "html-social-share/buttons",
  "title": "HTML Social Share Buttons",
  "category": "widgets",
  "icon": "share",
  "description": "Render HTML social share buttons with server-side sanitization.",
  "supports": {
    "html": false,
    "align": true
  },
  "attributes": {
    "networks": {
      "type": "array",
      "items": { "type": "string" },
      "default": [ "facebook", "twitter", "linkedin" ]
    },
    "iconset": {
      "type": "string",
      "default": "default"
    },
    "title": {
      "type": "string",
      "default": "Share this with your friends"
    },
    "alignment": {
      "type": "string",
      "default": "left"
    }
  },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
