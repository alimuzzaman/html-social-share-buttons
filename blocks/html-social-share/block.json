{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "html-social-share/html-social-share",
  "version": "1.1.0",
  "title": "HTML Social Share",
  "category": "widgets",
  "icon": "share",
  "description": "Add social sharing buttons to your content with customizable icons and styles.",
  "keywords": ["social", "share", "buttons", "icons"],
  "supports": {
    "html": false,
    "align": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "alignment": {
      "type": "string",
      "default": "left"
    },
    "iconSet": {
      "type": "string",
      "default": "default"
    },
    "showLabels": {
      "type": "boolean",
      "default": true
    },
    "showCounts": {
      "type": "boolean",
      "default": false
    },
    "selectedServices": {
      "type": "array",
      "default": ["facebook", "twitter", "linkedin", "email"]
    },
    "customUrl": {
      "type": "string",
      "default": ""
    },
    "customTitle": {
      "type": "string",
      "default": ""
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true
    },
    "noFollow": {
      "type": "boolean",
      "default": true
    },
    "buttonSize": {
      "type": "string",
      "default": "medium"
    },
    "buttonStyle": {
      "type": "string",
      "default": "rounded"
    }
  },
  "textdomain": "html-social-share-buttons",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.scss"
}
