{
  "name": "alimuzzaman/html-social-share-buttons",
  "description": "HTML Social Share Buttons plugin - PSR-4 setup",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "endroid/qr-code": "4.6"
  },
  "autoload": {
    "psr-4": {
      "HtmlSocialShare\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.3"
  },
  "scripts": {
    "test": "phpunit",
    "test:utils": "phpunit --configuration phpunit-utils.xml",
    "test:coverage": "phpunit --coverage-html reports/coverage",
    "test:security": "php security-audit.php",
    "test:performance": "php performance-test.php",
    "test:all": [
      "@test:utils",
      "@test:security", 
      "@test:performance"
    ]
  }
}
