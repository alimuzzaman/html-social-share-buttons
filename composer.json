{
	"name": "alim/html-social-share-buttons",
	"description": "Html Social Share Buttons WordPress plugin test harness.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.0"
	},
	"autoload": {
		"psr-4": {
			"Alimuzzaman\\HtmlSocialShareButtons\\": "src/"
		},
		"exclude-from-classmap": [
			"src/Compatibility/Legacy/Global/",
			"src/Compatibility/Legacy/IconSet/Definitions/"
		]
	},
	"scripts": {
		"test": "phpunit --configuration phpunit.xml.dist"
	}
}
