{
	"name": "alim/html-social-share-buttons",
	"description": "Html Social Share Buttons WordPress plugin test harness.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"psr-4": {
			"Alimuzzaman\\HtmlSocialShareButtons\\": "src/"
		},
		"exclude-from-classmap": [
			"src/Compatibility/Legacy/Api/globals.php"
		]
	},
	"scripts": {
		"test": "phpunit --configuration phpunit.xml.dist",
		"analyse": "phpstan analyse --configuration phpstan.neon.dist --memory-limit=1G",
		"phpcs": "phpcs --standard=phpcs.xml.dist",
		"quality": [
			"@analyse",
			"@phpcs"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
