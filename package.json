{
  "name": "html-social-share-buttons",
  "version": "1.1.0",
  "description": "WordPress plugin for adding social sharing buttons with modern React admin interface",
  "main": "build/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "wp-scripts start",
    "build:analyze": "wp-scripts build --analyze",
    "clean": "rimraf build",
    "lint": "wp-scripts lint-js",
    "lint:fix": "wp-scripts lint-js --fix",
    "lint:css": "wp-scripts lint-style",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "type-check": "wp-scripts check-engines",
    "prettier": "wp-scripts format",
    "test": "wp-scripts test-unit-js",
    "test:watch": "wp-scripts test-unit-js --watch",
    "test:coverage": "wp-scripts test-unit-js --coverage",
    "test:playwright:settings": "node dev-tools/test-settings-playwright.js",
    "test:playwright:frontend": "node tests/playwright/test-frontend-playwright.js",
    "test:playwright": "npm run test:playwright:settings ; npm run test:playwright:frontend",
    "test:e2e": "playwright test --config=config/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config=config/playwright.config.ts --headed",
    "playground:server": "npx @wp-playground/cli@latest server --blueprint=./build/blueprints/test-blueprint.json --auto-mount --login",
    "prepare": "husky install"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "social",
    "share",
    "buttons",
    "react",
    "gutenberg"
  ],
  "author": "HTML Social Share Team",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@wordpress/api-fetch": "^6.45.0",
    "@wordpress/block-editor": "^12.15.0",
    "@wordpress/blocks": "^12.25.0",
    "@wordpress/components": "^25.13.0",
    "@wordpress/compose": "^6.25.0",
    "@wordpress/data": "^9.17.0",
    "@wordpress/date": "^4.48.0",
    "@wordpress/e2e-test-utils-playwright": "^1.31.0",
    "@wordpress/element": "^5.25.0",
    "@wordpress/hooks": "^3.48.0",
    "@wordpress/html-entities": "^3.48.0",
    "@wordpress/i18n": "^4.48.0",
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/url": "^3.49.0",
    "@wp-playground/cli": "^3.0.5",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "playwright": "^1.55.1",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "wp-scripts lint-js --fix",
      "wp-scripts format"
    ],
    "*.{css,scss,md}": [
      "wp-scripts format"
    ]
  }
}
